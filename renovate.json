{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended",  "docker:enableMajor"],
  "commitMessagePrefix": ":rocket:",
  "prConcurrentLimit": 32,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "commitMessagePrefix": ":adhesive_bandage:"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": ":boom:"
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "commitMessagePrefix": "🤏"
    },
    {
      "matchPackageNames": ["alpine"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://alpinelinux.org/releases/"
    },
    {
      "matchPackageNames": ["quay.io/fedora/fedora-coreos"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d{8})\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "matchDatasources": ["custom.fcos-stable"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d{8})\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    }
  ],
  "customDatasources": {
    "fcos-stable": {
      "defaultRegistryUrlTemplate": "https://builds.coreos.fedoraproject.org/streams/stable.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": architectures.x86_64.artifacts.metal.release}], \"homepage\": \"https://fedoraproject.org/coreos/\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Fedora CoreOS stable stream for the FCOS compose image",
      "managerFilePatterns": [
        "/(^|/)compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*image:\\s*quay\\.io/fedora/fedora-coreos:(?<currentValue>[\\w.]+)\\s*$"
      ],
      "datasourceTemplate": "custom.fcos-stable",
      "depNameTemplate": "fcos-stable"
    },
    {
      "customType": "regex",
      "description": "Update Docker image versions in YAML label fields",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        ":\\s*docker://(?<depName>[^:]+):(?<currentValue>[vV]?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*ARG\\s+\\S+=(?<currentValue>\\S+)"
      ]
    },
  ]
}
