FROM alpine:3.24.2

# Infisical setup
RUN apk add bash sudo wget
RUN wget -qO- 'https://artifacts-cli.infisical.com/setup.apk.sh' | sudo sh

RUN apk update
RUN apk add git python3 py3-pip nodejs npm openssh curl docker-cli docker jq openrc grype buildah podman clamav infisical qemu-aarch64 unzip gcompat

# from: https://www.jeffgeerling.com/blog/2023/how-solve-error-externally-managed-environment-when-installing-pip3/
RUN rm -rf /usr/lib/python3.14/EXTERNALLY-MANAGED
RUN pip3 install ansible

# install dclint (docker-compose linter) globally so npx doesn't re-download it every run
RUN npm install -g dclint@3.1.0

# install UDS
# renovate: datasource=github-tags depName=defenseunicorns/uds-cli
ARG UDS_VERSION=v0.36.0
ENV UDS_VERSION=${UDS_VERSION}
RUN curl -fsSL "https://github.com/defenseunicorns/uds-cli/releases/download/${UDS_VERSION}/uds-cli_${UDS_VERSION}_Linux_amd64" -o /usr/local/bin/uds \
    && chmod +x /usr/local/bin/uds \
    && uds version

# install VirusTotal CLI
# renovate: datasource=github-tags depName=VirusTotal/vt-cli
ARG VTCLI_VERSION=1.3.1
ENV VTCLI_VERSION=${VTCLI_VERSION}
RUN curl -fsSL "https://github.com/VirusTotal/vt-cli/releases/download/${VTCLI_VERSION}/Linux64.zip" -o /tmp/vt.zip && \
    unzip -j /tmp/vt.zip -d /tmp/vt && \
    install -m 0755 /tmp/vt/vt /usr/local/bin/vt && \
    rm -rf /tmp/vt.zip /tmp/vt
